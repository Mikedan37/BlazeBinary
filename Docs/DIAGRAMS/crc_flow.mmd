graph TD
    A[Original Data] --> B[BlazeBinary Encode]
    B --> C[Binary Payload]
    C --> D[Calculate CRC32]
    D --> E[Append CRC32]
    E --> F[Framed Data]
    
    F --> G[Receive Frame]
    G --> H[Extract Payload]
    H --> I[Extract CRC32]
    I --> J{CRC32 Valid?}
    J -->|Yes| K[Decode Payload]
    J -->|No| L[Reject - CRC Error]
    K --> M[Decoded Value]
    
    style J fill:#34495e,stroke:#0d7377,stroke-width:2px,color:#ffffff
    style L fill:#e74c3c,stroke:#0d7377,stroke-width:2px,color:#ffffff
    style M fill:#27ae60,stroke:#0d7377,stroke-width:2px,color:#ffffff

